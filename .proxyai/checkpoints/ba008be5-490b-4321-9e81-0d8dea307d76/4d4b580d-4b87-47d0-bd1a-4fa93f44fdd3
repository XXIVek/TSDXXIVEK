ater: LayoutInflater, container: ViewGroup?,\n94\t        savedInstanceState: Bundle?\n95\t    ): View {\n96\t        // так лучше чем типовой пока\n97\t        _binding = FragmentScanerDBinding.inflate(inflater, container, false)\n98\t        redyScan=1\n99\t        return binding.root\n100\t    }\n101\t    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {\n102\t        super.onViewCreated(view, savedInstanceState)\n103\t\n104\t        manualInputSh=false\n105\t        previewViewAct  = binding.previewView\n106\t        with(previewViewAct) { setScaleType(PreviewView.ScaleType.FILL_CENTER) }\n107\t\n108\t        binding.tvScannedType.text = \"0\"\n109\t        binding.tvScannedData.text = \"Штрих код не распознан\"\n110\t        binding.layoutScanResultRab.visibility=View.GONE\n111\t        binding.layoutScanErr.visibility=View.GONE\n112\t        binding.layoytInput.visibility=View.GONE\n113\t        binding.layoutScanResultTest.visibility=View.GONE\n114\t        //Dennis\n115\t        binding.layoutScanResultRab.visibility=View.VISIBLE\n116\t        //Dennis\n117\t\n118\t        binding.bFlash.setOnClickListener {onFlash()}\n119\t        binding.buttonScan.setOnClickListener {onScan()}\n120\t//Dennis\n121\t        binding.numberPicker1.minValue = 0\n122\t        binding.numberPicker1.maxValue = 9\n123\t        binding.numberPicker1.wrapSelectorWheel = true\n124\t        binding.numberPicker1.descendantFocusability=NumberPicker.FOCUS_BLOCK_DESCENDANTS\n125\t\n126\t        binding.numberPicker2.minValue = 0\n127\t        binding.numberPicker2.maxValue = 9\n128\t        binding.numberPicker2.wrapSelectorWheel = true\n129\t        binding.numberPicker2.descendantFocusability=NumberPicker.FOCUS_BLOCK_DESCENDANTS\n130\t\n131\t        binding.numberPicker3.minValue = 0\n132\t        binding.numberPicker3.maxValue = 9\n133\t        binding.numberPicker3.wrapSelectorWheel = true\n134\t        binding.numberPicker3.descendantFocusability=NumberPicker.FOCUS_BLOCK_DESCENDANTS\n135\t\n136\t        binding.numberPicker4.minValue = 0\n137\t        binding.numberPicker4.maxValue = 9\n138\t        binding.numberPicker4.wrapSelectorWheel = true\n139\t        binding.numberPicker4.descendantFocusability=NumberPicker.FOCUS_BLOCK_DESCENDANTS\n140\t\n141\t        binding.numberPicker5.minValue = 0\n142\t        binding.numberPicker5.maxValue = 9\n143\t        binding.numberPicker5.wrapSelectorWheel = true\n144\t        binding.numberPicker5.descendantFocusability=NumberPicker.FOCUS_BLOCK_DESCENDANTS\n145\t\n146\t        binding.numberPicker1.value = 1\n147\t//        binding.fabRabConfirm.setBackgroundColor(Color.BLUE)\n148\t//        binding.fabRabNotConfirm.setBackgroundColor(Color.RED)\n149\t//        binding.sight.setBackgroundColor(Color.BLUE)\n150\t//        binding.bSkipIncrement.setBackgroundColor(Color.rgb(255,161,1))\n151\t\n152\t        binding.numberPicker1.setOnValueChangedListener { picker, oldVal, newVal ->\n153\t            ed = newVal\n154\t            resInput = ed + des + sot + tis + ttis\n155\t//            binding.testRes.text=resInput.toString()\n156\t        }\n157\t\n158\t        binding.numberPicker2.setOnValueChangedListener { picker, oldVal, newVal ->\n159\t            des = newVal * 10\n160\t            resInput = ed + des + sot + tis + ttis\n161\t//            binding.testRes.text=resInput.toString()\n162\t        }\n163\t\n164\t        binding.numberPicker3.setOnValueChangedListener { picker, oldVal, newVal ->\n165\t            sot = newVal * 100\n166\t            resInput = ed + des + sot + tis + ttis\n167\t//            binding.testRes.text=resInput.toString()\n168\t        }\n169\t\n170\t        binding.numberPicker4.setOnValueChangedListener { picker, oldVal, newVal ->\n171\t            tis = newVal * 1000\n172\t            resInput = ed + des + sot + tis + ttis\n173\t//            binding.testRes.text=resInput.toString()\n174\t        }\n175\t\n176\t        binding.numberPicker5.setOnValueChangedListener { picker, oldVal, newVal ->\n177\t            ttis = newVal * 10000\n178\t            resInput = ed + des + sot + tis + ttis\n179\t//            binding.testRes.text=resInput.toString()\n180\t        }\n181\t\n182\t//        binding.numberPickerSetincrement.setOnValueChangedListener { picker, oldVal, newVal ->\n183\t//            resIncrement=newVal\n184\t//            resInput=resIncrement\n185\t//            binding.textRabRes.text=resInput.toString()\n186\t//        }\n187\t         //Dennis\n188\t        binding.fabRabConfirm.setOnClickListener {\n189\t            onConfirm()\n190\t        }\n191\t        binding.fabRabNotConfirm.setOnClickListener {\n192\t            onScan()\n193\t        }\n194\t        binding.helpB.setOnClickListener {\n195\t            binding.layoutCamera.visibility = View.GONE\n196\t            binding.layoutScanResult.visibility = View.GONE\n197\t            binding.returnB.visibility = View.VISIBLE\n198\t            binding.helpView.visibility = View.VISIBLE\n199\t            binding.helpView.setImageResource(R.drawable.help)\n200\t        }\n201\t        binding.returnB.setOnClickListener {\n202\t            binding.layoutCamera.visibility = View.VISIBLE\n203\t            binding.layoutScanResult.visibility = View.VISIBLE\n204\t            binding.returnB.visibility = View.GONE\n205\t            binding.helpView.visibility = View.GONE\n206\t        }\n207\t        binding.bErrScan.setOnClickListener {onScan()}\n208\t        //Dennis\n209\t        binding.bSkipIncrement.setOnClickListener {\n210\t            resIncrement=1\n211\t            resInput=1\n212\t //           binding.testRes.text=resIncrement.toString()\n213\t            binding.numberPicker1.value=1\n214\t            binding.numberPicker2.value=0\n215\t            binding.numberPicker3.value=0\n216\t            binding.numberPicker4.value=0\n217\t            binding.numberPicker5.value=0\n218\t            binding.sight.text = \"+\"\n219\t            sight = true\n220\t            binding.fabRabConfirm.text=\"ПРИБАВИТЬ\"\n221\t            binding.sight.setBackgroundColor(ContextCompat.getColor(requireContext(), R.color.colorPrimary))\n222\t            binding.fabRabConfirm.setBackgroundColor(ContextCompat.getColor(requireContext(), R.color.colorPrimary))\n223\t        }\n224\t        binding.sight.setOnClickListener {\n225\t            if (sight) {\n226\t                sight = false\n227\t                binding.sight.text = \"-\"\n228\t                binding.fabRabConfirm.text=\"ОТНЯТЬ\"\n229\t                binding.fabRabConfirm.setBackgroundColor(ContextCompat.getColor(requireContext(), R.color.error))\n230\t                binding.sight.setBackgroundColor(ContextCompat.getColor(requireContext(), R.color.error))\n231\t//                binding.testRes.text=resInput.unaryMinus().toString()\n232\t            }\n233\t            else {\n234\t                sight = true\n235\t                binding.sight.text = \"+\"\n236\t//                binding.testRes.text=resInput.toString()\n237\t                binding.fabRabConfirm.text=\"ПРИБАВИТЬ\"\n238\t                binding.sight.setBackgroundColor(ContextCompat.getColor(requireContext(), R.color.colorPrimary))\n239\t                binding.fabRabConfirm.setBackgroundColor(ContextCompat.getColor(requireContext(), R.color.colorPrimary))\n240\t            }\n241\t        }\n242\t//        binding.fabRabMin.setOnClickListener {changeResInput(-1)}\n243\t//        binding.fabRabPlus.setOnClickListener {changeResInput(1)}\n244\t        //Dennis\n245\t        binding.calc.setOnClickListener {\n246\t            binding.layoutScanResultRab.visibility=View.GONE\n247\t            binding.layoytInput.visibility=View.VISIBLE\n248\t            binding.textInputRes.text=\"0\"\n249\t         }\n250\t\n251\t//работа клавиатуры\n252\t        binding.bInput1.setOnClickListener {setNum(\"1\")}\n253\t        binding.bInput2.setOnClickListener {setNum(\"2\")}\n254\t        binding.bInput3.setOnClickListener {setNum(\"3\")}\n255\t        binding.bInput4.setOnClickListener {setNum(\"4\")}\n256\t        binding.bInput5.setOnClickListener {setNum(\"5\")}\n257\t        binding.bInput6.setOnClickListener {setNum(\"6\")}\n258\t        binding.bInput7.setOnClickListener {setNum(\"7\")}\n259\t        binding.bInput8.setOnClickListener {setNum(\"8\")}\n260\t        binding.bInput9.setOnClickListener {setNum(\"9\")}\n261\t        binding.bInput0.setOnClickListener {setNum(\"0\")}\n262\t        binding.bInput00.setOnClickListener {setNum(\"00\")}\n263\t        binding.bInputPoint.setOnClickListener {} //пока не знаю надо или нет\n264\t        binding.bInputClear.setOnClickListener {\n265\t            binding.textInputRes.text=\"0\"\n266\t        }\n267\t        binding.bInputMinus.setOnClickListener {\n268\t            binding.textInputRes.text=\"-\"+binding.textInputRes.text\n269\t        }\n270\t        binding.bInputEnter.setOnClickListener {fInputEnter()}\n271\t\n272\t        binding.bManualinputSh.setOnClickListener {fManualinputSh()}\n273\t\n274\t// Управление фокусом\n275\t        binding.previewView.setOnClickListener {\n276\t//            if (camera.cameraControl!=null) {\n277\t                if (valZoom == 0.7f) {\n278\t                    valZoom = 0.4f\n279\t                } else {\n280\t                    valZoom = 0.7f\n281\t                }\n282\t                camera.cameraControl.setLinearZoom(valZoom)\n283\t//            }\n284\t        }\n285\t\n286\t         setupCamera()\n287\t\n288\t    }\n289\t\n290\t    private fun fManualinputSh(){\n291\t        manualInputSh=true\n292\t        binding.layoytBlank.visibility=View.GONE\n293\t        binding.layoytInput.visibility=View.VISIBLE\n294\t        binding.textInputRes.text=\"0\"\n295\t        redyScan=0\n296\t    }\n297\t    private fun fInputEnter(){\n298\t        if (manualInputSh) {\n299\t            val manInpSh=binding.textInputRes.text.toString()\n300\t            binding.layoytInput.visibility = View.GONE\n301\t            manualInputSh=false\n302\t            barcodeAnalysis(manInpSh,1)\n303\t        }else{\n304\t            resInput=binding.textInputRes.text.toString().toInt()\n305\t            binding.layoytInput.visibility=View.GONE\n306\t            if (resInput==0){\n307\t//                binding.testRes.text=resIncrement.toString()\n308\t            }else{\n309\t//              binding.testRes.text=resInput.toString()\n310\t                //Dennis\n311\t                var ost = resInput\n312\t                var prom = (ost/10000).toInt()\n313\t                ost = ost % 10000\n314\t                binding.numberPicker5.value=prom\n315\t                ttis=prom*10000\n316\t                prom = ost/1000\n317\t                ost = ost % 1000\n318\t                binding.numberPicker4.value=prom\n319\t                tis=prom*1000\n320\t                prom = ost/100\n321\t                ost = ost % 100\n322\t                binding.numberPicker3.value=prom\n323\t                sot=prom*100\n324\t                prom = ost/10\n325\t                ost = ost % 10\n326\t                binding.numberPicker2.value=prom\n327\t                des=prom*10\n328\t                binding.numberPicker1.value=ost\n329\t                ed=ost\n330\t                resInput = ed + des + sot + tis + ttis\n331\t                //Dennis\n332\t            }\n333\t            binding.textInputRes.text=\"0\"\n334\t            binding.layoutScanResultRab.visibility=View.VISIBLE\n335\t        }\n336\t    }\n337\t\n338\t    private fun setupCamera() {\n339\t        cameraSelector = CameraSelector.Builder().requireLensFacing(lensFacing).build()\n340\t\n341\t        ViewModelProvider(\n342\t            this, ViewModelProvider.AndroidViewModelFactory.getInstance(TSDXXIVekApplication())\n343\t        ).get(CameraXViewModel::class.java)\n344\t            .processCameraProvider\n345\t            .observe(viewLifecycleOwner) { provider: ProcessCameraProvider? -> cameraProvider = provider\n346\t               bindCameraUseCases()\n347\t            }\n348\t    }\n349\t\n350\t    private fun setNum(text_num:String){\n351\t        var textInputRes=binding.textInputRes.text.toString()\n352\t        if ((text_num==\"0\")||(text_num==\"00\")) {\n353\t            if (textInputRes != \"0\") {\n354\t                textInputRes += text_num\n355\t            }\n356\t        }\n357\t        else{\n358\t            if (textInputRes == \"0\") {\n359\t                textInputRes = text_num\n360\t            } else {\n361\t                textInputRes += text_num\n362\t            }\n363\t        }\n364\t        binding.textInputRes.text=textInputRes\n365\t    }\n366\t\n367\t    private fun onScan() {\n368\t        binding.tvScannedType.text = \"0\"\n369\t        binding.tvScannedData.text = \"Штрих код не распознан\"\n370\t        redyScan=1\n371\t        manualInputSh=false\n372\t        bindPreviewUseCase()\n373\t        bindAnalyseUseCase()\n374\t        if (appLic.appLIC==\"-1\"){\n375\t            binding.layoutScanResultTest.visibility=View.VISIBLE\n376\t            binding.layoytBlank.visibility=View.GONE\n377\t            binding.layoutScanResultRab.visibility=View.GONE\n378\t        }else {\n379\t            binding.textBlank.text=\"Наведите камеру на штрихкод\"\n380\t            binding.bManualinputSh.visibility=View.VISIBLE\n381\t            binding.layoytBlank.visibility=View.VISIBLE\n382\t            binding.layoutScanResultRab.visibility=View.GONE\n383\t            binding.layoutScanResultTest.visibility=View.GONE\n384\t        }\n385\t    }\n386\t\n387\t    private fun onFlash(){\n388\t        laitFlash=!laitFlash\n389\t        camera.cameraControl.enableTorch(laitFlash)\n390\t    }\n391\t\n392\t    private fun onConfirm(){\n393\t        binding.fabRabConfirm.visibility=View.INVISIBLE\n394\t        binding.fabRabNotConfirm.visibility=View.INVISIBLE\n395\t        if ((resItem.itemSh.isNotBlank())&&(resInput!=0)) {\n396\t            var mRes=resItem.itemQuantityInStock\n397\t            //Dennis\n398\t            //mRes+=resInput\n399\t            if (sight) {\n400\t                mRes+=resInput\n401\t            }\n402\t            else {\n403\t                mRes+=resInput.unaryMinus()\n404\t            }\n405\t            //Dennis\n406\t            viewModelDB.addNewItem(\n407\t                resItem.itemSh,\n408\t                resItem.itemShTip.toString(),\n409\t                resItem.itemName,\n410\t                resItem.itemPrice.toString(),\n411\t                resItem.itemQuantityInStock.toString(),\n412\t                mRes.toString()\n413\t            )\n414\t        }\n415\t        onScan()\n416\t    }\n417\t\n418\t    //строем два блока Preview и Analyse\n419\t    private fun bindCameraUseCases() {\n420\t        bindPreviewUseCase()\n421\t        val cameraControl=camera.cameraControl\n422\t//        cameraControl.setZoomRatio(0.1f)\n423\t        cameraControl.setLinearZoom(valZoom)\n424\t//        val cameraInfo = camera.cameraInfo\n425\t//        cameraInfo.zoomState.observe(viewLifecycleOwner, Observer { zoomState ->\n426\t//            // Use the zoom state to retireve information about the zoom ratio, etc\n427\t//            val currentZoomRatio = zoomState.zoomRatio\n428\t//            // ...\n429\t//        })\n430\t        val factory: MeteringPointFactory = SurfaceOrientedMeteringPointFactory(\n431\t            previewViewAct.width.toFloat(), previewViewAct.height.toFloat())\n432\t        val centerWidth = previewViewAct.width.toFloat() / 2\n433\t        val centerHeight = previewViewAct.height.toFloat() / 2\n434\t        //create a point on the center of the view\n435\t        val autoFocusPoint2 = factory.createPoint(centerWidth, centerHeight)\n436\t        try {\n437\t            camera.cameraControl.startFocusAndMetering(\n438\t                FocusMeteringAction.Builder(\n439\t                    autoFocusPoint2,\n440\t                    FocusMete