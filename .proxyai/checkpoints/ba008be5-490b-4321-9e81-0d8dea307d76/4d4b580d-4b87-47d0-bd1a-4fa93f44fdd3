                    "text": "1\tpackage com.xxivek.tsdxxivek\n2\t\n3\timport android.content.Context\n4\timport android.util.Log\n5\t\n6\t/**\n7\t * Парсер QR-кода для сопряжения в файловом режиме.\n8\t * Формат: PAIR:true;socket:false;konf:1;LOGGING:0\n9\t */\n10\tclass QrPairingParser {\n11\t\n12\t    companion object {\n13\t        private const val TAG = \"QrPairingParser\"\n14\t        private const val PREFIX = \"PAIR:\"\n15\t    }\n16\t\n17\t    /**\n18\t     * Результат парсинга QR-кода.\n19\t     */\n20\t    data class PairingResult(\n21\t        val paired: Boolean,\n22\t        val useSocket: Boolean,\n23\t        val konf: Int,\n24\t        val logging: Boolean,\n25\t        val port: Int = 0,\n26\t        val license: String = \"-1\",\n27\t        val activationCode: String = \"\"\n28\t    ) {\n29\t        fun isValid(): Boolean = paired && konf >= 0\n30\t    }\n31\t\n32\t    /**\n33\t     * Распарсить QR-код.\n34\t     * Поддерживаемые форматы:\n35\t     * 1. Socket/Сайт: PAIR:<activation_code> (например PAIR:ABC123)\n36\t     * 2. Локальный USB: PAIR:true;socket:false;konf:1;LOGGING:0;\n37\t     * 3. Локальный WIFI: PAIR:true;socket:true;konf:1;LOGGING:0;Port:8180;Lic:1;\n38\t     */\n39\t    fun parse(qrData: String): PairingResult {\n40\t        Log.d(TAG, \"Парсинг QR: $qrData\")\n41\t\n42\t        if (!qrData.startsWith(PREFIX)) {\n43\t            Log.w(TAG, \"Неверный формат QR-кода (нет PAIR:)\")\n44\t            return PairingResult(false, false, -1, false)\n45\t        }\n46\t\n47\t        val rest = qrData.substringAfter(PREFIX, \"\")\n48\t\n49\t        // Формат 1: Socket/Сайт — PAIR:<activation_code>\n50\t        // activation_code = 6 символов A-Z, 0-9, без \";\"\n51\t        if (!rest.contains(\";\")) {\n52\t            val activationCode = rest.trim().uppercase()\n53\t            Log.d(TAG, \"Распознан формат Socket/Сайт: activation_code=$activationCode\")\n54\t            return PairingResult(\n55\t                paired = true,\n56\t                useSocket = true,\n57\t                konf = 1,\n58\t                logging = false,\n59\t                activationCode = activationCode\n60\t            )\n61\t        }\n62\t\n63\t        // Форматы 2 и 3: Локальный USB / WIFI — PAIR:true;socket:...;konf:...;...\n64\t        val parts = rest.split(\";\")\n65\t\n66\t        var paired = false\n67\t        var useSocket = false\n68\t        var konf = -1\n69\t        var logging = false\n70\t        var port = 0\n71\t        var license = \"-1\"\n72\t\n73\t        for (part in parts) {\n74\t            val trimmed = part.trim()\n75\t            when {\n76\t                trimmed.equals(\"true\", ignoreCase = true) -> {\n77\t                    paired = true\n78\t                }\n79\t                trimmed.equals(\"false\", ignoreCase = true) -> {\n80\t                    // socket:false означает файловый режим\n81\t                    useSocket = false\n82\t                }\n83\t                trimmed.startsWith(\"socket:\", ignoreCase = true) -> {\n84\t                    useSocket = trimmed.substringAfter(\":\", \"\").trim().equals(\"true\", ignoreCase = true)\n85\t                }\n86\t                trimmed.startsWith(\"konf:\", ignoreCase = true) -> {\n87\t                    konf = trimmed.substringAfter(\":\", \"\").trim().toIntOrNull() ?: -1\n88\t                }\n89\t                trimmed.startsWith(\"LOGGING:\", ignoreCase = true) -> {\n90\t                    logging = trimmed.substringAfter(\":\", \"\").trim().toIntOrNull() == 1\n91\t                }\n92\t                trimmed.startsWith(\"Port:\", ignoreCase = true) -> {\n93\t                    port = trimmed.substringAfter(\":\", \"\").trim().toIntOrNull() ?: 0\n94\t                }\n95\t                trimmed.startsWith(\"Lic:\", ignoreCase = true) -> {\n96\t                    license = trimmed.substringAfter(\":\", \"\").trim()\n97\t                }\n98\t            }\n99\t        }\n100\t\n101\t        Log.d(TAG, \"Результат: paired=$paired, useSocket=$useSocket, konf=$konf, logging=$logging, port=$port, license=$license\")\n102\t        return PairingResult(paired, useSocket, konf, logging, port, license)\n103\t    }\n104\t\n105\t    /**\n106\t     * Сохранить результат сопряжения в SharedPreferences.\n107\t     */\n108\t    fun savePairing(context: Context, result: PairingResult) {\n109\t        if (!result.isValid()) {\n110\t            Log.w(TAG, \"Невалидный результат сопряжения, не сохраняем\")\n111\t            return\n112\t        }\n113\t\n114\t        val prefs = context.getSharedPreferences(\"settings\", Context.MODE_PRIVATE)\n115\t        prefs.edit().apply {\n116\t            putString(AppConstants.APP_PREF_LIC, result.license)\n117\t            putString(AppConstants.APP_PREF_PORT, result.port.toString())\n118\t            putString(AppConstants.APP_PREF_KONF, result.konf.toString())\n119\t            putBoolean(AppConstants.APP_PREF_USE_SOCKET, result.useSocket)\n120\t            putBoolean(AppConstants.APP_PREF_LOGGING, result.logging)\n121\t            apply()\n122\t        }\n123\t\n124\t        Log.d(TAG, \"Сопряжение сохранено: konf=${result.konf}, socket=${result.useSocket}, logging=${result.logging}, port=${result.port}, license=${result.license}\")\n125\t    }\n126\t\n127\t    /**\n128\t     * Сгенерировать QR-код для сопряжения (для отображения на ТСД).\n129\t     */\n130\t    fun generatePairingQr(konf: Int, logging: Boolean, port: Int = 0, license: String = \"-1\"): String {\n131\t        return \"PAIR:true;socket:true;konf:$konf;LOGGING:${if (logging) 1 else 0};Port:$port;Lic:$license\"\n132\t    }\n133\t}\n134"
